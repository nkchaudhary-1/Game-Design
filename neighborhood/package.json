{
  "name": "neighborhood",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NEIGHBORHOOD \u2014 Prototype 01: a walkable, multiplayer 3D street (Maple Street, Block 01)",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/main.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:artifact": "tsc --noEmit && vite build -c vite.artifact.config.ts && node scripts/make-artifact.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
