# Port the single service listens on (HTTP + WebSocket on the same origin)
PORT=8080
# Optional. When set, rooms persist in Redis and survive a server restart.
# Leave empty to use the in-memory store.
REDIS_URL=
# Comma-separated list of allowed browser origins for WebSocket upgrades.
# Leave empty to allow same-origin only (recommended for the single-service deploy).
ALLOWED_ORIGINS=
# Public base URL used for invite links and Open Graph tags, e.g. https://undercover.fly.dev
PUBLIC_URL=
# Multiply every game timer by this factor (0.05 makes a 60s timer 3s). Used by simulations only.
TIMER_SCALE=1
